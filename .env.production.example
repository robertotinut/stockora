# ==============================================================================
# Stockora Production Environment Template (Placeholder Values Only)
# Copy to `.env` on the production server ONLY inside an approved deployment window.
# NEVER commit real secrets, keys, passwords, or `.env.production` to VCS.
# ==============================================================================

APP_NAME=Stockora
APP_ENV=production
# Generate securely on the target host with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=database
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Stockora Operational Settings (config/stockora.php)
STOCKORA_PLATFORM_NAME="Stockora Control Plane"
STOCKORA_TIMEZONE=Asia/Jakarta
STOCKORA_SUPPORT_EMAIL=onboarding@example.com
STOCKORA_SUPPORT_PHONE="+62 21 0000 0000"
STOCKORA_SUPPORT_WHATSAPP="+62 800 0000 0000"
STOCKORA_SUPPORT_HOURS="Mon - Fri, 09:00 - 18:00 WIB"
STOCKORA_ACTIVATION_SLA="Our onboarding team reviews new business registrations within 1 business day and activates approved accounts manually."

# Logging (Daily rotation; avoid `debug` in production to prevent bloat/leakage)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production MySQL Database (Dedicated least-privilege app & migrator users)
# Fail-closed guard: ALL THREE keys below must intentionally match before `APP_ENV=production` boots.
STOCKORA_ALLOW_PRODUCTION_DB=false
STOCKORA_APPROVED_PRODUCTION_DATABASE=stockora_prod
STOCKORA_PRODUCTION_DB_APPROVAL=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockora_prod
DB_USERNAME=stockora_app_prod
DB_PASSWORD=CHANGE_ME_STRONG_APP_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Optional TLS CA bundle path when using managed MySQL over TCP:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Dedicated higher-privilege account used ONLY during `php artisan migrate --force`
DB_MIGRATOR_USERNAME=stockora_migrator_prod
DB_MIGRATOR_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_DB_PASSWORD

# Reverse Proxy & Session Hardening (Only list trusted proxy IPs/CIDRs; empty = trust none)
STOCKORA_TRUSTED_PROXIES=127.0.0.1
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache, Queue & Private/Public Storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=stockora_prod_

# Production SMTP Delivery (Non-log mailer enables Invitation & Direct Customer Welcome emails)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example-provider.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_SECRET
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=app.example.com

VITE_APP_NAME="${APP_NAME}"
